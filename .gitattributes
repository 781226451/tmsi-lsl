# Normalise line endings: LF in the repository, CRLF only where Windows needs it.
* text=auto

*.py   text
*.qml  text
*.md   text
*.toml text
*.json text
*.yml  text
*.yaml text
*.txt  text
.gitignore    text
.gitattributes text

# Windows-only launchers keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.vbs  text eol=crlf
*.ps1  text eol=crlf

# Binaries
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.woff binary
*.woff2 binary
